erDiagram
    users ||--o{ businesses : "owner_id"
    users ||--o{ reservations : "customer_id"
    categories ||--o{ businesses : "category_id"
    businesses ||--o{ services : "business_id"
    businesses ||--o{ business_schedules : "business_id"
    businesses ||--o{ reservations : "business_id"
    services ||--o{ reservations : "service_id"
    reservations |o--o| queues : "reservation_id"
    businesses ||--o{ queues : "business_id"
    users {
        bigint id PK
        varchar name
        varchar email UK
        varchar password_hash
        varchar role
        boolean active
        datetime created_at
        datetime updated_at
    }
    categories {
        bigint id PK
        varchar name UK
        datetime created_at
        datetime updated_at
    }
    businesses {
        bigint id PK
        bigint owner_id FK
        bigint category_id FK
        varchar name
        text description
        text address
        varchar phone
        varchar status
        int active_staff_count
        int max_capacity
        datetime created_at
        datetime updated_at
    }
    services {
        bigint id PK
        bigint business_id FK
        varchar name
        text description
        decimal price
        int estimated_duration_minutes
        boolean is_active
        datetime created_at
        datetime updated_at
    }
    business_schedules {
        bigint id PK
        bigint business_id FK
        varchar day_of_week
        time open_time
        time close_time
        boolean is_closed
        datetime created_at
        datetime updated_at
    }
    reservations {
        bigint id PK
        bigint customer_id FK
        bigint business_id FK
        bigint service_id FK
        varchar reservation_code UK
        date reservation_date
        time reservation_time
        varchar status
        text notes
        datetime created_at
        datetime updated_at
    }
    queues {
        bigint id PK
        bigint reservation_id FK
        bigint business_id FK
        int queue_number
        date queue_date
        varchar status
        datetime called_at
        datetime started_at
        datetime completed_at
        datetime created_at
    }
